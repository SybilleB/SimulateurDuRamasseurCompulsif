<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="SimulateurDuRamasseurCompulsif.userControl.choixRace">
    
    
    <UserControl.Styles>
        
        <Style Selector="Border.borderCarte">
            <Setter Property="Width" Value="240"></Setter>
            <Setter Property="Height" Value="380"></Setter>
            <Setter Property="CornerRadius" Value="15"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="Background" Value="#FF000000"></Setter>
            <Setter Property="BoxShadow" Value="0 10 20 0 #40000000"></Setter>
            <Setter Property="ClipToBounds" Value="True"></Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"></TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Border.borderCarte:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1)"></Setter>
        </Style>
        
        <Style Selector="Border.borderCarte Image">
            <Setter Property="Stretch" Value="UniformToFill"></Setter>
        </Style>
        
        <Style Selector="Border.borderCarte:pointerover Image">
            <Setter Property="Effect">
                <BlurEffect Radius="10"></BlurEffect>
            </Setter>
        </Style>
        
        <Style Selector="Border.overlay">
            <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
            <Setter Property="Height" Value="250"></Setter>
            <Setter Property="Margin" Value="-2,0,-2,-2"></Setter>
            <Setter Property="CornerRadius" Value="0 0 15 15"></Setter>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#00000000"></GradientStop>
                    <GradientStop Offset="0.25" Color="#E6000000"></GradientStop>
                    <GradientStop Offset="1" Color="#FF000000"></GradientStop>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Opacity" Value="0.4"></Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"></DoubleTransition>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Border.borderCarte:pointerover Border.overlay">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        
        <Style Selector="StackPanel.descriptions">
            <Setter Property="MaxHeight" Value="0"></Setter>
            <Setter Property="Opacity" Value="0"></Setter>
            <Setter Property="ClipToBounds" Value="True"></Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="MaxHeight" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Border.borderCarte:pointerover StackPanel.descriptions">
            <Setter Property="MaxHeight" Value="300"></Setter>
            <Setter Property="Opacity" Value="1"></Setter>
        </Style>
        
        <Style Selector="StackPanel.blocDescription">
            <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
            <Setter Property="Margin" Value="15 0 15 70"></Setter>
        </Style>
        
        <Style Selector="TextBlock.titreRace">
            <Setter Property="FontFamily" Value="{StaticResource Metamorphous}"></Setter>
            <Setter Property="FontSize" Value="27"></Setter>
            <Setter Property="Foreground" Value="#E0E0E0"></Setter>
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="TextAlignment" Value="Center"></Setter>
        </Style>
        
        <Style Selector="StackPanel.descriptions">
            <Setter Property="Spacing" Value="10"></Setter>
        </Style>
        
        <Style Selector="TextBlock.description">
            <Setter Property="FontFamily" Value="{StaticResource Alice}"></Setter>
            <Setter Property="FontSize" Value="12"></Setter>
            <Setter Property="Foreground" Value="#888"></Setter>
            <Setter Property="TextWrapping" Value="Wrap"></Setter>
        </Style>
        
        <Style Selector="Border.borderTalent">
            <Setter Property="Padding" Value="5"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="CornerRadius" Value="5"></Setter>
        </Style>
        
        <Style Selector="TextBlock.titreTalent">
            <Setter Property="FontFamily" Value="{StaticResource Metamorphous}"></Setter>
            <Setter Property="FontSize" Value="13"></Setter>
            <Setter Property="Foreground" Value="#E0E0E0"></Setter>
            <Setter Property="TextAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
        </Style>
        
        <Style Selector="Button.boutonChoisir">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
            <Setter Property="Background" Value="#BF161618"></Setter>
            <Setter Property="Foreground" Value="#E0E0E0"></Setter>
            <Setter Property="BorderBrush" Value="#333"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="FontFamily" Value="{StaticResource Alice}"></Setter>
            <Setter Property="Margin" Value="20,0,20,12"></Setter>
            <Setter Property="Padding" Value="5"></Setter>
            <Setter Property="CornerRadius" Value="4"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Cursor="{TemplateBinding Cursor}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="{TemplateBinding Margin}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}">
                            
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <Style Selector="Border.borderCarte:pointerover Button.boutonChoisir">
            <Setter Property="Background" Value="#BF161618"></Setter>
            <Setter Property="Foreground" Value="#D4AF37"></Setter>
            <Setter Property="BorderBrush" Value="#D4AF37"></Setter>
        </Style>
        
        <Style Selector="Button.boutonChoisir:pointerover">
            <Setter Property="Background" Value="#D4AF37"></Setter>
            <Setter Property="Foreground" Value="#111"></Setter>
            <Setter Property="BorderBrush" Value="#D4AF37"></Setter>
        </Style>
        
    </UserControl.Styles>
    
    <Grid Background="#121212">
        
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Padding="30,10" Margin="30 30 0 0" 
                Background="Transparent" Cursor="Hand" Click="onRetourClick">
            <TextBlock Foreground="#888" FontFamily="{StaticResource Alice}" FontSize="15" >
                ❮ RETOUR
            </TextBlock>
        </Button>
        
        <StackPanel VerticalAlignment="Center" Spacing="50">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="28" FontFamily="{StaticResource Metamorphous}" Foreground="#E0E0E0" LetterSpacing="2">
                CHOISISSEZ VOTRE ORIGINE
            </TextBlock>
            
            <UniformGrid Rows="1" HorizontalAlignment="Stretch" Margin="20 0">
                <Border Classes="borderCarte">
                    <Grid>
                        <Image Source="avares://SimulateurDuRamasseurCompulsif/assets/pictures/humain_v2.png"></Image>
                        <Border Classes="overlay"></Border>
                        <StackPanel Classes="blocDescription">
                            <TextBlock Classes="titreRace">
                                Humain
                            </TextBlock>
                            
                            <StackPanel Classes="descriptions">
                                <TextBlock Classes="description">
                                    Polyvalent et ambitieux, l'humain s'adapte à toutes les situations.
                                </TextBlock>
                                
                                <TextBlock Classes="description">
                                    +3 points de compétences à répartir
                                </TextBlock>
                                
                                <Border Classes="borderTalent">
                                    <StackPanel>
                                        <TextBlock Classes="titreTalent" Name="titreTalentHumain">
                                            Volonté de fer
                                        </TextBlock>
                                        <TextBlock Classes="description" Name="descriptionTalentHumain">
                                             Garde 1 PV au lieu de mourir, par pure obstination.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Classes="boutonChoisir" Name="choixHumain" Click="onRaceClick">
                            <TextBlock>Choisir</TextBlock>
                        </Button>
                    </Grid>
                </Border>
                
                <Border Classes="borderCarte">
                    <Grid>
                        <Image Source="avares://SimulateurDuRamasseurCompulsif/assets/pictures/elfe_v2.png"></Image>
                        <Border Classes="overlay"></Border>
                        <StackPanel Classes="blocDescription">
                            <TextBlock Classes="titreRace">
                                Elfe
                            </TextBlock>
                            
                            <StackPanel Classes="descriptions">
                                <TextBlock Classes="description">
                                    Etre gracieux et agile, maître de l'arc et de la magie naturelle.
                                </TextBlock>
                                
                                <TextBlock Classes="description">
                                    +1 charisme, +1 intelligence, +1 agilité
                                </TextBlock>
                                
                                <TextBlock Classes="description">
                                    -2 vitalité
                                </TextBlock>
                                <Border Classes="borderTalent">
                                    <StackPanel>
                                        <TextBlock Classes="titreTalent" Name="titreTalentElfe">
                                            Vision Nocturne
                                        </TextBlock>
                                        <TextBlock Classes="description" Name="descriptionTalentElfe">
                                             Repère les pièges assez tôt pour ne pas abimer ses cheveux.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Classes="boutonChoisir" Name="choixElfe" Click="onRaceClick">
                            <TextBlock>Choisir</TextBlock>
                        </Button>
                    </Grid>
                </Border>
                
                <Border Classes="borderCarte">
                    <Grid>
                        <Image Source="avares://SimulateurDuRamasseurCompulsif/assets/pictures/nain_v2.png"></Image>
                        <Border Classes="overlay"></Border>
                        <StackPanel  Classes="blocDescription">
                            <TextBlock  Classes="titreRace">
                                Nain
                            </TextBlock>
                            
                            <StackPanel  Classes="descriptions">
                                <TextBlock Classes="description">
                                    Combattant robuste et obstiné, expert des profondeurs et de la forge.
                                </TextBlock>
                                <TextBlock Classes="description">
                                    +1 force, +1 vitalité
                                </TextBlock>
                                <TextBlock Classes="description">
                                    -1 intelligence, -1 agilité
                                </TextBlock>
                                
                                <Border Classes="borderTalent">
                                    <StackPanel>
                                        <TextBlock Classes="titreTalent" Name="titreTalentNain">
                                            Forgeron
                                        </TextBlock>
                                        <TextBlock Classes="description" Name="descriptionTalentNain">
                                             Considère que porter une armure "Commune" est une insulte à ses ancêtres.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Classes="boutonChoisir" Name="choixNain" Click="onRaceClick">
                            <TextBlock>Choisir</TextBlock>
                        </Button>
                    </Grid>
                </Border>
                
                <Border Classes="borderCarte">
                    <Grid>
                        <Image Source="avares://SimulateurDuRamasseurCompulsif/assets/pictures/gobelin_v2.png"></Image>
                        <Border Classes="overlay"></Border>
                        <StackPanel  Classes="blocDescription">
                            <TextBlock  Classes="titreRace">
                                Gobelin
                            </TextBlock>
                            
                            <StackPanel  Classes="descriptions">
                                <TextBlock Classes="description">
                                    Créature rusée et agile, compensant sa petite taille par sa malice et sa cupidité.
                                </TextBlock>
                                
                                <TextBlock Classes="description">
                                    +2 intelligence, +1 agilité
                                </TextBlock>
                                
                                <TextBlock Classes="description">
                                    -2 charisme, -1 force
                                </TextBlock>
                                
                                <Border Classes="borderTalent">
                                    <StackPanel>
                                        <TextBlock Classes="titreTalent" Name="titreTalentGobelin">
                                            Pillard
                                        </TextBlock>
                                        <TextBlock Classes="description" Name="descriptionTalentGobelin">
                                             Gagne 10% d'or bonus grâce à son talent pour secouer les cadavres encore chauds.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Classes="boutonChoisir" Name="choixGobelin" Click="onRaceClick">
                            <TextBlock>Choisir</TextBlock>
                        </Button>
                    </Grid>
                </Border>
                
                <Border Classes="borderCarte">
                    <Grid>
                        <Image Source="avares://SimulateurDuRamasseurCompulsif/assets/pictures/fee_v3.png"></Image>
                       
                        <Border Classes="overlay"></Border>
                        
                        <StackPanel  Classes="blocDescription">
                            <TextBlock  Classes="titreRace">
                                Fée
                            </TextBlock>
                            
                            <StackPanel  Classes="descriptions">
                                <TextBlock Classes="description">
                                    Minuscule et insaisissable, elle manie la magie ancienne et voltige avec grâce.
                                </TextBlock>
                                
                                <TextBlock Classes="description">
                                    +1 agilité, +1 chance
                                </TextBlock>
                                
                                <TextBlock Classes="description">
                                    -2 force
                                </TextBlock>
                                
                                <Border Classes="borderTalent">
                                    <StackPanel>
                                        <TextBlock Classes="titreTalent" Name="titreTalentFee">
                                            Providence Ailée
                                        </TextBlock>
                                        <TextBlock Classes="description" Name="descriptionTalentFee">
                                             Améliore le butin trouvé parce qu'elle a des goûts de luxe et peu de patience.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Classes="boutonChoisir" Name="choixFee" Click="onRaceClick">
                            <TextBlock>Choisir</TextBlock>
                        </Button>
                    </Grid>
                </Border>
            </UniformGrid> 
        </StackPanel>
    </Grid>
</UserControl>