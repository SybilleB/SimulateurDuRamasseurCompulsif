<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="SimulateurDuRamasseurCompulsif.userControl.validerCreation">

    <UserControl.Styles>
        <Style Selector="TextBlock.labelStat">
            <Setter Property="FontFamily" Value="{StaticResource Alice}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#888"/>
        </Style>
        <Style Selector="TextBlock.valueStat">
            <Setter Property="FontFamily" Value="{StaticResource Alice}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#121212">
        
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30" 
                Background="Transparent" Cursor="Hand" Click="onRetourClick">
            <TextBlock Foreground="#666" FontFamily="{StaticResource Alice}" FontSize="15">❮ RETOUR INVENTAIRE</TextBlock>
        </Button>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            
            <TextBlock Text="FICHE DE PERSONNAGE" FontFamily="{StaticResource Metamorphous}" FontSize="32" 
                       Foreground="#D4AF37" HorizontalAlignment="Center" Margin="0 0 0 10"/>

            <Border Name="cartePersonnage" Width="800" Height="450" CornerRadius="12" 
                    BorderBrush="#444" BorderThickness="1" BoxShadow="0 10 40 0 #000000">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#1E1E24"/>
                        <GradientStop Offset="1" Color="#141414"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnDefinitions="1.2*, 2*" Margin="30">
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="15">
                        
                        <Border Width="160" Height="160" CornerRadius="80" BorderBrush="#D4AF37" BorderThickness="2" 
                                ClipToBounds="True" BoxShadow="0 0 20 0 #20D4AF37" HorizontalAlignment="Center">
                            <Image Name="imgAvatarFinal" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Spacing="5">
                            <TextBlock Name="txtNomFinal" Text="Nom du Joueur" FontFamily="{StaticResource Metamorphous}" 
                                       FontSize="24" Foreground="#D4AF37" TextAlignment="Center" TextWrapping="Wrap"/>
                            
                            <Border Background="#333" HorizontalAlignment="Center" CornerRadius="4" Padding="10 2">
                                <TextBlock Name="txtTitreFinal" Text="Le Vagabond" FontFamily="{StaticResource Alice}" 
                                           FontSize="14" Foreground="#AAA" FontStyle="Italic"/>
                            </Border>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0 15 0 0">
                            <TextBlock Name="txtRaceFinal" Text="Humain" Classes="valueStat" Foreground="#BDC3C7"/>
                            <TextBlock Text="|" Foreground="#444"/>
                            <TextBlock Name="txtClasseFinal" Text="Guerrier" Classes="valueStat" Foreground="#BDC3C7"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="#333" Margin="0 20"/>

                    <Grid Grid.Column="1" Margin="40 10 0 10" RowDefinitions="Auto, *">
                        
                        <TextBlock Grid.Row="0" Text="Statistiques &amp; Attributs" FontFamily="{StaticResource Alice}" 
                                   FontSize="18" Foreground="#666" Margin="0 0 0 20" TextDecorations="Underline"/>

                        <UniformGrid Grid.Row="1" Columns="2" Rows="3">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="⚔️" FontSize="20"/>
                                <StackPanel>
                                    <TextBlock Text="Force" Classes="labelStat"/>
                                    <TextBlock Name="valForce" Text="10" Classes="valueStat"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="📖" FontSize="20"/>
                                <StackPanel>
                                    <TextBlock Text="Intelligence" Classes="labelStat"/>
                                    <TextBlock Name="valIntel" Text="10" Classes="valueStat"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="🏹" FontSize="20"/>
                                <StackPanel>
                                    <TextBlock Text="Agilité" Classes="labelStat"/>
                                    <TextBlock Name="valAgi" Text="10" Classes="valueStat"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="👑" FontSize="20"/>
                                <StackPanel>
                                    <TextBlock Text="Charisme" Classes="labelStat"/>
                                    <TextBlock Name="valCharisme" Text="10" Classes="valueStat"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="💖" FontSize="20"/>
                                <StackPanel>
                                    <TextBlock Text="Vitalité" Classes="labelStat"/>
                                    <TextBlock Name="valVitalite" Text="10" Classes="valueStat"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="🎲" FontSize="20"/>
                                <StackPanel>
                                    <TextBlock Text="Chance" Classes="labelStat"/>
                                    <TextBlock Name="valChance" Text="10" Classes="valueStat"/>
                                </StackPanel>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                
                <Button Background="#333" Foreground="White" Padding="20 10" CornerRadius="5" Cursor="Hand" Click="OnExporterClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📷"/>
                        <TextBlock Text="EXPORTER EN IMAGE" FontFamily="{StaticResource Alice}"/>
                    </StackPanel>
                </Button>

                <Button Background="#D4AF37" Foreground="Black" Padding="30 10" CornerRadius="5" Cursor="Hand" Click="OnTerminerClick">
                    <TextBlock Text="COMMENCER L'AVENTURE ❯" FontFamily="{StaticResource Alice}" FontWeight="Bold"/>
                </Button>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</UserControl>