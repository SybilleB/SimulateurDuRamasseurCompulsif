<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="SimulateurDuRamasseurCompulsif.userControl.inventaire">

    <UserControl.Styles>
        
        <Style Selector="TextBlock.ptsCompetence">
            <Setter Property="FontFamily" Value="{StaticResource Alice}"></Setter>
            <Setter Property="FontSize" Value="14"></Setter>
            <Setter Property="Foreground" Value="#E0E0E0"></Setter>
        </Style>
        
        <Style Selector="Border.items">
            <Setter Property="Width" Value="90"></Setter>
            <Setter Property="Height" Value="90"></Setter>
            <Setter Property="Background" Value="#252525"></Setter>
            <Setter Property="BorderBrush" Value="#444"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="CornerRadius" Value="4"></Setter>
            <Setter Property="Margin" Value="8"></Setter>
            <Setter Property="BoxShadow" Value="0 2 5 0 #20000000"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Border.items:pointerover">
            <Setter Property="BorderBrush" Value="#D4AF37"></Setter>
            <Setter Property="Background" Value="#353535"></Setter>
            <Setter Property="RenderTransform" Value="scale(1.05)"></Setter>
            <Setter Property="BoxShadow" Value="0 0 10 0 #40D4AF37"></Setter>
            <Setter Property="ZIndex" Value="10"></Setter> </Style>
        
        <Style Selector="Border.items TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="FontFamily" Value="{StaticResource Alice}"></Setter>
            <Setter Property="Foreground" Value="#666"></Setter>
            <Setter Property="FontSize" Value="11"></Setter>
            <Setter Property="TextWrapping" Value="Wrap"></Setter>
            <Setter Property="TextAlignment" Value="Center"></Setter>
        </Style>
        
    </UserControl.Styles>
    
    
    <Grid Background="#121212">
        
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Padding="30,10" Margin="30 30 0 0" 
                Background="Transparent" Cursor="Hand" Click="onRetourClick">
            <TextBlock Foreground="#888" FontFamily="{StaticResource Alice}" FontSize="15" >
                ❮ RETOUR
            </TextBlock>
        </Button>
        
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Padding="30,10" Margin="0 30 30 0" 
                Background="Transparent" Cursor="Hand" Click="onCreationPersonnageClick">
            <TextBlock Foreground="#888" FontFamily="{StaticResource Alice}" FontSize="15" >
                CREER LE PERSONNAGE ❯
            </TextBlock>
        </Button>
        
        <Border Width="900" Height="500" BorderBrush="#333" BorderThickness="1" CornerRadius="8" BoxShadow="0 10 30 0 #000000">
            
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                
                <Border Grid.Column="0" CornerRadius="9 0 0 0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0" Color="#1E1E24"></GradientStop>
                            <GradientStop Offset="1" Color="#161618"></GradientStop>
                        </LinearGradientBrush>
                    </Border.Background>
                
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="1.3*"></RowDefinition>
                        </Grid.RowDefinitions>
                        
                            
                        <StackPanel Grid.Row="0" Spacing="15" Margin="0 40 0 15">
                            
                            <Border Width="100" Height="100" CornerRadius="50" ClipToBounds="True" BoxShadow="0 0 20 0 #20D4AF37">
                                <Image Name="imgAvatarJoueur" Source="avares://SimulateurDuRamasseurCompulsif/assets/pictures/defaultPP.png" Stretch="UniformToFill"/>
                            </Border>
                                
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource Metamorphous}"
                                       FontSize="26" Foreground="#D4AF37" Name="txtNomJoueur">
                            </TextBlock>
                                
                            <TextBlock FontFamily="{StaticResource Alice}" FontSize="14" Foreground="#666" TextWrapping="Wrap" HorizontalAlignment="Center" Name="titreHonorifique"></TextBlock>
                        </StackPanel>
                            
                        <Border Grid.Row="1" Width="250" BorderBrush="#333" BorderThickness="0 0 0 1"></Border>
                            
                        <StackPanel Grid.Row="2" Margin="40 20 0 0" Spacing="30">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="ptsCompetence" Name="forceInventaire"></TextBlock>
                                <TextBlock Classes="ptsCompetence" Name="agiliteInventaire"></TextBlock>
                                <TextBlock Classes="ptsCompetence" Name="vitaliteInventaire"></TextBlock>
                                <TextBlock Classes="ptsCompetence" Name="intelligenceInventaire"></TextBlock>
                                <TextBlock Classes="ptsCompetence" Name="charismeInventaire"></TextBlock>
                                <TextBlock Classes="ptsCompetence" Name="chanceInventaire"></TextBlock>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Spacing="25">
                                <TextBlock Foreground="#E0E0E0" FontFamily="{StaticResource Alice}" FontSize="16">
                                    ❤️ 100 HP
                                </TextBlock>
                                <TextBlock Foreground="#E0E0E0" FontFamily="{StaticResource Alice}" FontSize="16">
                                    🪙 100 Or
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <Border Grid.Column="1" Width="1" Background="#333"></Border>
                
                <StackPanel Grid.Column="2">
                    <StackPanel Margin="30" Spacing="5">
                        <TextBlock FontFamily="{StaticResource Metamorphous}" FontSize="30" Foreground="#D4AF37">SACOCHE</TextBlock>
                        <TextBlock FontFamily="{StaticResource Alice}" FontSize="14" Foreground="#888">Ce que vous avez ramassé (ou volé) en chemin.</TextBlock>
                    </StackPanel>
                    
                    <UniformGrid Rows="4" Columns="5" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top">

                        <Border Classes="items" Name="item1"><Image Source="../assets/pictures/map.png"></Image></Border>
                        <Border Classes="items" Name="item2"><Image Source="../assets/pictures/pain.png"></Image></Border>
                        <Border Classes="items" Name="item3"><TextBlock>Carte</TextBlock></Border>
                        <Border Classes="items" Name="item4"><TextBlock>Pain</TextBlock></Border>
                        

                        <Border Classes="items"></Border>
                        <Border Classes="items"></Border>
                        <Border Classes="items"></Border>
                        <Border Classes="items"></Border>
                        

                        <Border Classes="items"></Border>
                        <Border Classes="items"></Border>
                        <Border Classes="items"></Border>
                        <Border Classes="items"></Border>
                        

                        
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>