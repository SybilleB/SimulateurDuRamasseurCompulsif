<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="SimulateurDuRamasseurCompulsif.userControl.competences">

    <UserControl.Styles>
        <Style Selector="Button.btnStat">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="#404A3B2A"/>
            <Setter Property="Foreground" Value="#2F1B0C"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#2A2A2A">
        <Border Width="500" Height="650" VerticalAlignment="Center">
            <Border.Background>
                <ImageBrush Source="avares://SimulateurDuRamasseurCompulsif/assets/pictures/parchemin_v2.png" Stretch="UniformToFill"/>
            </Border.Background>

            <Grid Margin="50 40">
                <StackPanel>
                    
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource Metamorphous}"
                               FontSize="28" Foreground="#4A3B2A" Margin="0 0 0 10">
                        Destinée
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0 0 0 10">
                        <Border Width="50" Height="50" CornerRadius="10" Background="#F0EAD6" BorderBrush="#4A3B2A" BorderThickness="2">
                            <TextBlock Name="txtDe1" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontFamily="{StaticResource Metamorphous}" Foreground="#2F1B0C"/>
                        </Border>
                        <Border Width="50" Height="50" CornerRadius="10" Background="#F0EAD6" BorderBrush="#4A3B2A" BorderThickness="2">
                            <TextBlock Name="txtDe2" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontFamily="{StaticResource Metamorphous}" Foreground="#2F1B0C"/>
                        </Border>
                    </StackPanel>

                    <Button Content="🎲 Lancer les dés" HorizontalAlignment="Center" Margin="0 0 0 10"
                            Background="#CC4A3B2A" Foreground="#E9E7CA" FontFamily="{StaticResource Alice}" CornerRadius="10"/>

                    <TextBlock TextAlignment="Center" FontFamily="{StaticResource Alice}" FontSize="16" Foreground="#4A3B2A" Margin="0 0 0 15">
                        Points disponibles : <Run Name="runPointsRestants" FontWeight="Bold" FontSize="20">0</Run>
                    </TextBlock>

                    <Border BorderThickness="0 1 0 0" BorderBrush="#804A3B2A" Width="300" HorizontalAlignment="Center" Margin="0 0 0 15"/>

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="120, Auto, 40, Auto" HorizontalAlignment="Center">
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Force" VerticalAlignment="Center" FontFamily="{StaticResource Alice}" FontSize="18" Foreground="#4A3B2A"/>
                        <Button Grid.Row="0" Grid.Column="1" Classes="btnStat" Content="-" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Name="txtValForce" Text="0" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Metamorphous}" FontSize="20" Foreground="#2F1B0C"/>
                        <Button Grid.Row="0" Grid.Column="3" Classes="btnStat" Content="+"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Agilité" Margin="0 10" VerticalAlignment="Center" FontFamily="{StaticResource Alice}" FontSize="18" Foreground="#4A3B2A"/>
                        <Button Grid.Row="1" Grid.Column="1" Classes="btnStat" Content="-"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Name="txtValAgilite" Text="0" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Metamorphous}" FontSize="20" Foreground="#2F1B0C"/>
                        <Button Grid.Row="1" Grid.Column="3" Classes="btnStat" Content="+"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Vitalité" Margin="0 10" VerticalAlignment="Center" FontFamily="{StaticResource Alice}" FontSize="18" Foreground="#4A3B2A"/>
                        <Button Grid.Row="2" Grid.Column="1" Classes="btnStat" Content="-"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Name="txtValVitalite" Text="0" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Metamorphous}" FontSize="20" Foreground="#2F1B0C"/>
                        <Button Grid.Row="2" Grid.Column="3" Classes="btnStat" Content="+"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Intelligence" Margin="0 10" VerticalAlignment="Center" FontFamily="{StaticResource Alice}" FontSize="18" Foreground="#4A3B2A"/>
                        <Button Grid.Row="3" Grid.Column="1" Classes="btnStat" Content="-"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Name="txtValIntel" Text="0" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Metamorphous}" FontSize="20" Foreground="#2F1B0C"/>
                        <Button Grid.Row="3" Grid.Column="3" Classes="btnStat" Content="+"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Charisme" Margin="0 10" VerticalAlignment="Center" FontFamily="{StaticResource Alice}" FontSize="18" Foreground="#4A3B2A"/>
                        <Button Grid.Row="4" Grid.Column="1" Classes="btnStat" Content="-"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Name="txtValCharisme" Text="0" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Metamorphous}" FontSize="20" Foreground="#2F1B0C"/>
                        <Button Grid.Row="4" Grid.Column="3" Classes="btnStat" Content="+"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Chance" Margin="0 10" VerticalAlignment="Center" FontFamily="{StaticResource Alice}" FontSize="18" Foreground="#4A3B2A"/>
                        <Button Grid.Row="5" Grid.Column="1" Classes="btnStat" Content="-"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Name="txtValChance" Text="0" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Metamorphous}" FontSize="20" Foreground="#2F1B0C"/>
                        <Button Grid.Row="5" Grid.Column="3" Classes="btnStat" Content="+"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>