<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="SimulateurDuRamasseurCompulsif.userControl.menuEcranTitre">

    <UserControl.Styles>
        <Style Selector="Button.btnMenu">
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="BorderBrush" Value="#444"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="Foreground" Value="#D4AF37"></Setter>
            <Setter Property="FontFamily" Value="{StaticResource Metamorphous}"></Setter>
            <Setter Property="FontSize" Value="14"></Setter>
            <Setter Property="CornerRadius" Value="4"></Setter>
            <Setter Property="Padding" Value="40,15"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
            
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter>
            
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"></TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.btnMenu:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#22FFFFFF"></Setter>
            <Setter Property="BorderBrush" Value="#D4AF37"></Setter>
        </Style>
        <Style Selector="Button.btnMenu:pointerover">
             <Setter Property="RenderTransform" Value="scale(1.02)"></Setter>
        </Style>
    </UserControl.Styles>


        <Grid Background="#121212">
            
            <Border Width="900" Height="500" BorderBrush="#444" BorderThickness="1" BoxShadow="0 10 30 0 #000000" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#1E1E24"></GradientStop>
                        <GradientStop Offset="1" Color="#161618"></GradientStop>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="1"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8 0 0 8" ClipToBounds="True">
                        <Grid>
                            <Image Source="avares://SimulateurDuRamasseurCompulsif/assets/pictures/menu_v1.png" Stretch="UniformToFill"></Image>
                            <Border Background="#40000000"></Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#333" VerticalAlignment="Stretch"></Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="50" Spacing="40">
                        
                        <StackPanel Spacing="10">
                            <TextBlock FontFamily="{StaticResource Alice}" FontSize="14" Foreground="#888" LetterSpacing="4" HorizontalAlignment="Center">
                                LE SIMULATEUR DU
                            </TextBlock>
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource Metamorphous}" FontSize="42" Foreground="#D4AF37" TextAlignment="Center" LineHeight="50" HorizontalAlignment="Center">
                                    RAMASSEUR
                                </TextBlock>
                                <TextBlock FontFamily="{StaticResource Metamorphous}" FontSize="42" Foreground="#D4AF37" TextAlignment="Center" LineHeight="50" HorizontalAlignment="Center">
                                    COMPULSIF
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="15" Width="250">
                            <Button Classes="btnMenu" Name="boutonNouvellePartie" Click="OnNouvellePartieClick">
                                <TextBlock>NOUVELLE PARTIE</TextBlock>
                            </Button>
                            
                            <Button Classes="btnMenu" Name="boutonCharger" Click="OnChargerClick">
                                <TextBlock>CHARGER</TextBlock>
                            </Button>
                            
                            <Button Classes="btnMenu" Name="boutonQuitter" Click="OnQuitterClick">
                                <TextBlock>QUITTER</TextBlock>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>


</UserControl>
